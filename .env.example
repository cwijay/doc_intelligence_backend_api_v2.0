# ===========================================
# DOCUMENT INTELLIGENCE BACKEND CONFIGURATION
# ===========================================

# Application Settings
PROJECT_NAME="Document Intelligence API"
VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# JWT Configuration
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=30

# ===========================================
# FIREBASE/FIRESTORE CONFIGURATION
# ===========================================

# Firebase Project Settings
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com/"

# Google Application Credentials
# Option 1: Path to service account JSON file (recommended for development)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/firebase-service-account-key.json"

# Option 2: Service account JSON content (for production/containers)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project",...}'

# ===========================================
# GOOGLE CLOUD SERVICES
# ===========================================

# Google Cloud Platform Project (can be same as Firebase or different)
GCP_PROJECT_ID="your-gcp-project-id"

# Google Cloud Storage (for folder management and file uploads)
GCS_BUCKET_NAME="biz-to-bricks-document-store"

# Document Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES='["pdf", "xlsx"]'
DOCUMENT_UPLOAD_TIMEOUT=300  # 5 minutes in seconds
SIGNED_URL_EXPIRATION_MINUTES=60  # Default signed URL expiration

# ===========================================
# AI/ML SERVICES
# ===========================================

# Pinecone Configuration (Vector Database)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="your-pinecone-environment"
PINECONE_INDEX_NAME="document-intelligence"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-5-mini"
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.0

# LlamaParse Configuration
LLAMAPARSE_API_KEY="your-llamaparse-api-key"

# ===========================================
# CACHING AND SESSIONS
# ===========================================

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# ===========================================
# API CONFIGURATION
# ===========================================

# CORS Settings (JSON array format or comma-separated)
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080","https://yourdomain.com"]'

# Production CORS Origins (for Cloud Run deployment)
# Option 1: JSON array format
PRODUCTION_CORS_ORIGINS='["https://yourdomain.com","https://www.yourdomain.com","https://app.yourdomain.com"]'
# Option 2: Comma-separated format
# PRODUCTION_CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com"

# Frontend domain for automatic CORS origin detection
FRONTEND_DOMAIN="yourdomain.com"

# Cloud Run service URL (optional - auto-detected if not provided)
CLOUD_RUN_SERVICE_URL="https://your-service-name-hash-region.a.run.app"

# CORS configuration
CORS_CREDENTIALS=true
CORS_METHODS='["GET","POST","PUT","DELETE","OPTIONS","PATCH"]'
CORS_HEADERS='["Authorization","Content-Type","X-Requested-With","Accept","Origin","Cache-Control","X-File-Name"]'

# Enable CORS debugging (development only)
ENABLE_CORS_DEBUG=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# File Upload Settings (Legacy - see Document Configuration above for new settings)
# MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
# ALLOWED_FILE_TYPES='[".pdf",".docx",".txt",".md"]'

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

LOG_LEVEL="INFO"
LOG_FORMAT="json"  # json or text
LOG_FILE="/var/log/document-intelligence.log"  # Optional: path to log file

# ===========================================
# HEALTH CHECK SETTINGS
# ===========================================

HEALTH_CHECK_TIMEOUT=30